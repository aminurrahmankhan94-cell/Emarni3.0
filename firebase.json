{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "ignore": [
        "node_modules/**",
        ".git/**",
        ".github/**",
        ".env*",
        "index.html",
        "style.css",
        "app.js",
        "firebase.js",
        "README*.md",
        "database.rules.json",
        "storage.rules",
        "firebase.json",
        ".firebaserc",
        "deploy-firebase.yml",
        "package-lock.json",
        "set-admin.js"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "README-BN.md",
      "README-GITHUB-BN.md",
      "package.json",
      "package-lock.json",
      "set-admin.js",
      "index.js",
      "database.rules.json",
      "storage.rules",
      "deploy-firebase.yml"
    ]
  }
}
